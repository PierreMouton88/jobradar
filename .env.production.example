POSTGRES_USER=jobradar
POSTGRES_PASSWORD=replace_with_a_strong_password
POSTGRES_DB=jobradar

DATABASE_URL="postgresql://jobradar:replace_with_a_strong_password@postgres:5432/jobradar"

APIFY_TOKEN="your_apify_token"
OPENAI_API_KEY="your_openai_api_key"
USE_FAKE_AI=false

JOBRADAR_APP_BASE_URL="https://jobradar.example.com"

SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="your_smtp_user"
SMTP_PASSWORD="your_smtp_password"
REPORT_EMAIL_FROM="jobradar@example.com"
REPORT_EMAIL_TO="you@example.com"

# Workflow quotidien : désactivé par défaut.
DAILY_WORKFLOW_ENABLED=true

DAILY_APIFY_ENABLED=false
DAILY_RAG_ENABLED=false
DAILY_AI_ENABLED=false
DAILY_EMAIL_ENABLED=false

DAILY_MAX_LOCATIONS=3
DAILY_MAX_OFFERS_PER_PLAN=10
DAILY_MAX_RAG_DOCUMENTS=20
DAILY_MAX_EMBEDDINGS=5
DAILY_MAX_AI_ANALYSES=3

DAILY_TIMEZONE=Europe/Paris

# Chemin interne au conteneur worker.
JOBRADAR_RUNTIME_DIR=/app/runtime
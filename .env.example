DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/DATABASE_NAME"
OPENAI_API_KEY="your_api_key_here"
USE_FAKE_AI=true
API_KEY="your_api_key_here"

SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="your_smtp_user"
SMTP_PASSWORD="your_smtp_password"
REPORT_EMAIL_FROM="jobradar@example.com"
REPORT_EMAIL_TO="you@example.com"


# Daily JobRadar workflow
# Toutes les actions externes restent désactivées par défaut.
DAILY_WORKFLOW_ENABLED=false

DAILY_APIFY_ENABLED=false
DAILY_RAG_ENABLED=false
DAILY_AI_ENABLED=false
DAILY_EMAIL_ENABLED=false

DAILY_MAX_LOCATIONS=3
DAILY_MAX_OFFERS_PER_PLAN=10
DAILY_MAX_RAG_DOCUMENTS=20
DAILY_MAX_EMBEDDINGS=5
DAILY_MAX_AI_ANALYSES=3

DAILY_TIMEZONE=Europe/Paris

# Dossier persistant pour les verrous et futurs journaux du worker.
JOBRADAR_RUNTIME_DIR=./runtime

MANUAL_DEMO_WORKFLOW_ENABLED=true
MANUAL_DEMO_ACCESS_CODE=
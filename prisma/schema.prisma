generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ContractType {
  CDI
  CDD
  STAGE
  ALTERNANCE
  FREELANCE
  INCONNU
}

enum ScrapingRunStatus {
  SUCCESS
  FAILED
  PARTIAL
}

enum ImportCampaignStatus {
  RUNNING
  SUCCESS
  PARTIAL
  FAILED
}

enum ImportCampaignRunStatus {
  RUNNING
  SUCCESS
  PARTIAL
  FAILED
}

enum ImportCampaignOfferAction {
  CREATED
  UPDATED
  REJECTED_BY_RELEVANCE
  PREVIEW_ERROR
  IMPORT_ERROR
}

model JobOffer {
  id           String       @id @default(cuid())
  title        String
  company      String
  location     String
  contractType ContractType @default(INCONNU)
  remote       Boolean      @default(false)
  skills       String[]
  description  String
  source       String
  url          String       @unique
  scrapedAt    DateTime

  qualityScore  Int      @default(100)
  qualityIssues String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scrapingRunId        String?
  scrapingRun          ScrapingRun?          @relation(fields: [scrapingRunId], references: [id])
  importCampaignOffers ImportCampaignOffer[]

  analysis JobAnalysis?

  embedding JobOfferEmbedding?

  @@index([source])
  @@index([contractType])
  @@index([scrapedAt])
}

model ScrapingRun {
  id                String             @id @default(cuid())
  source            String
  status            ScrapingRunStatus  @default(SUCCESS)
  offersCount       Int                @default(0)
  startedAt         DateTime           @default(now())
  finishedAt        DateTime?
  errorMessage      String?
  importCampaignRun ImportCampaignRun?

  offers JobOffer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([source])
  @@index([status])
  @@index([startedAt])
}

model JobAnalysis {
  id String @id @default(cuid())

  jobOfferId String   @unique
  jobOffer   JobOffer @relation(fields: [jobOfferId], references: [id], onDelete: Cascade)

  summary          String
  requiredSkills   String[]
  niceToHaveSkills String[]
  experienceLevel  String
  remotePolicy     String
  salaryMentioned  Boolean
  redFlags         String[]
  positiveSignals  String[]

  analysisMode String  @default("fake")
  modelName    String?
  inputTokens  Int?
  outputTokens Int?
  totalTokens  Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([experienceLevel])
  @@index([remotePolicy])
  @@index([analysisMode])
}

model JobOfferEmbedding {
  id String @id @default(cuid())

  jobOfferId String   @unique
  jobOffer   JobOffer @relation(fields: [jobOfferId], references: [id], onDelete: Cascade)

  content   String
  embedding Unsupported("vector(1536)")

  modelName String @default("text-embedding-3-small")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([jobOfferId])
}

model CandidateProfile {
  id String @id @default(cuid())

  name     String
  headline String
  level    String

  targetRoles        String[]
  strongSkills       String[]
  learningSkills     String[]
  preferredContracts String[]
  preferredRemote    String
  preferredLocations String[]

  positiveSignals String[]
  negativeSignals String[]

  notes String?

  isDefault Boolean @default(false)
  isActive  Boolean @default(true)

  searchScenarios SearchScenario[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isDefault])
  @@index([isActive])
}

model SearchScenario {
  id String @id @default(cuid())

  name        String
  description String?

  candidateProfileId String
  candidateProfile   CandidateProfile @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)

  targetRoles     String[]
  keywords        String[]
  locations       String[]
  remotePolicies  String[]
  contractTypes   String[]
  sourceProviders String[]
  sourceNames     String[]

  isDefault Boolean @default(false)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([candidateProfileId])
  @@index([isDefault])
  @@index([isActive])
}

model RagDocumentEmbedding {
  id String @id @default(cuid())

  sourceType String
  sourceId   String
  title      String
  content    String
  metadata   Json?

  embedding Unsupported("vector(1536)")
  modelName String                      @default("text-embedding-3-small")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sourceType, sourceId])
  @@index([sourceType])
  @@index([sourceId])
}

model ImportCampaign {
  id String @id @default(cuid())

  sourceType String               @default("apify")
  status     ImportCampaignStatus @default(RUNNING)
  dryRun     Boolean              @default(false)

  selectedSources   String[] @default([])
  selectedLocations String[] @default([])

  searchScenarioId   String?
  searchScenarioName String?
  candidateProfileId String?
  candidateName      String?

  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  totalRawItems            Int @default(0)
  totalMappedOffers        Int @default(0)
  totalPreparedOffers      Int @default(0)
  totalUniqueOffers        Int @default(0)
  totalAcceptedByRelevance Int @default(0)
  totalRejectedByRelevance Int @default(0)
  totalCreated             Int @default(0)
  totalUpdated             Int @default(0)
  totalDuplicatesSkipped   Int @default(0)
  totalErrors              Int @default(0)

  errorMessage String?

  runs   ImportCampaignRun[]
  offers ImportCampaignOffer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([dryRun])
  @@index([startedAt])
  @@index([sourceType])
}

model ImportCampaignRun {
  id String @id @default(cuid())

  campaignId String
  campaign   ImportCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  source      String
  actorId     String?
  displayName String?
  location    String?
  limit       Int?
  sourceLabel String?

  status ImportCampaignRunStatus @default(RUNNING)

  rawItems          Int @default(0)
  mappedOffers      Int @default(0)
  preparedOffers    Int @default(0)
  uniqueOffers      Int @default(0)
  duplicatesSkipped Int @default(0)
  previewErrors     Int @default(0)

  relevanceFilterEnabled  Boolean @default(false)
  relevanceFilterMinScore Int?
  acceptedByRelevance     Int     @default(0)
  rejectedByRelevance     Int     @default(0)

  relevanceRejectionReasonCounts Json?

  created Int @default(0)
  updated Int @default(0)
  errors  Int @default(0)

  errorMessage String?

  scrapingRunId String?      @unique
  scrapingRun   ScrapingRun? @relation(fields: [scrapingRunId], references: [id], onDelete: SetNull)

  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  offers ImportCampaignOffer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([campaignId])
  @@index([source])
  @@index([status])
  @@index([startedAt])
}

model ImportCampaignOffer {
  id String @id @default(cuid())

  campaignId String
  campaign   ImportCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  campaignRunId String?
  campaignRun   ImportCampaignRun? @relation(fields: [campaignRunId], references: [id], onDelete: Cascade)

  jobOfferId String?
  jobOffer   JobOffer? @relation(fields: [jobOfferId], references: [id], onDelete: SetNull)

  action ImportCampaignOfferAction

  source     String
  externalId String?
  title      String?
  company    String?
  location   String?
  url        String?

  relevanceScore   Int?
  relevanceReasons String[] @default([])

  errorMessage String?

  createdAt DateTime @default(now())

  @@index([campaignId])
  @@index([campaignRunId])
  @@index([jobOfferId])
  @@index([action])
  @@index([source])
  @@index([url])
}

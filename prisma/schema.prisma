
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ContractType {
  CDI
  CDD
  STAGE
  ALTERNANCE
  FREELANCE
  INCONNU
}

enum ScrapingRunStatus {
  SUCCESS
  FAILED
  PARTIAL
}

model JobOffer {
  id           String       @id @default(cuid())
  title        String
  company      String
  location     String
  contractType ContractType @default(INCONNU)
  remote       Boolean      @default(false)
  skills       String[]
  description  String
  source       String
  url          String       @unique
  scrapedAt    DateTime

  qualityScore  Int      @default(100)
  qualityIssues String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scrapingRunId String?
  scrapingRun   ScrapingRun? @relation(fields: [scrapingRunId], references: [id])

  analysis JobAnalysis?

  embedding JobOfferEmbedding?

  @@index([source])
  @@index([contractType])
  @@index([scrapedAt])
}

model ScrapingRun {
  id           String            @id @default(cuid())
  source       String
  status       ScrapingRunStatus @default(SUCCESS)
  offersCount  Int               @default(0)
  startedAt    DateTime          @default(now())
  finishedAt   DateTime?
  errorMessage String?

  offers JobOffer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([source])
  @@index([status])
  @@index([startedAt])
}

model JobAnalysis {
  id String @id @default(cuid())

  jobOfferId String   @unique
  jobOffer   JobOffer @relation(fields: [jobOfferId], references: [id], onDelete: Cascade)

  summary          String
  requiredSkills   String[]
  niceToHaveSkills String[]
  experienceLevel  String
  remotePolicy     String
  salaryMentioned  Boolean
  redFlags         String[]
  positiveSignals  String[]

  analysisMode String  @default("fake")
  modelName    String?
  inputTokens  Int?
  outputTokens Int?
  totalTokens  Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([experienceLevel])
  @@index([remotePolicy])
  @@index([analysisMode])
}

model JobOfferEmbedding {
  id String @id @default(cuid())

  jobOfferId String   @unique
  jobOffer   JobOffer @relation(fields: [jobOfferId], references: [id], onDelete: Cascade)

  content   String
  embedding Unsupported("vector(1536)")

  modelName String @default("text-embedding-3-small")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([jobOfferId])
}

model CandidateProfile {
  id String @id @default(cuid())

  name     String
  headline String
  level    String

  targetRoles        String[]
  strongSkills       String[]
  learningSkills     String[]
  preferredContracts String[]
  preferredRemote    String
  preferredLocations String[]

  positiveSignals String[]
  negativeSignals String[]

  notes String?

  isDefault Boolean @default(false)
  isActive  Boolean @default(true)

  searchScenarios SearchScenario[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isDefault])
  @@index([isActive])
}

model SearchScenario {
  id String @id @default(cuid())

  name        String
  description String?

  candidateProfileId String
  candidateProfile   CandidateProfile @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)

  targetRoles     String[]
  keywords        String[]
  locations       String[]
  remotePolicies  String[]
  contractTypes   String[]
  sourceProviders String[]
  sourceNames     String[]

  isDefault Boolean @default(false)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([candidateProfileId])
  @@index([isDefault])
  @@index([isActive])
}
